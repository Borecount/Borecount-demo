# Copy to .env.hosted and replace every CHANGE_ME value.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://luxledger:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/luxledger_demo_hosted
# Generate with node --input-type=module -e "import { generateApiKey } from '@borecount/core/application'; console.log(generateApiKey())"
BOOTSTRAP_ADMIN_API_KEY=CHANGE_ME_GENERATED_LLK_KEY
JWT_SIGNING_KEY=CHANGE_ME_BASE64URL_32_BYTE_SECRET

BOOTSTRAP_TENANT_NAME=Demo tenant
BOOTSTRAP_ADMIN_KEY_NAME=Hosted demo admin
JWT_ISSUER=luxledger-demo
HOSTED_PORT=8080
