{
  "name": "borecount-demo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev -w @borecount/demo-api",
    "dev:local": "concurrently -n api,web -c blue,green \"npm run dev:api:local\" \"npm run dev:web\"",
    "dev:api:local": "node --env-file=.env --watch --import tsx apps/api/src/index.ts",
    "dev:web": "npm run dev -w @borecount/demo-web",
    "demo": "node scripts/demo-local.mjs",
    "start": "npm run start -w @borecount/demo-api",
    "start:hosted": "npm run db:migrate -w @borecount/demo-api && npm run start -w @borecount/demo-api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @borecount/demo-api",
    "db:migrate:local": "node --env-file=.env scripts/migrate-local.mjs",
    "bootstrap:admin-key": "npm run bootstrap:admin-key -w @borecount/demo-api",
    "bootstrap:admin-key:local": "node --env-file=.env --import tsx apps/api/src/bootstrap-admin-key.ts",
    "build": "npm run build --workspaces --if-present",
    "verify:openapi": "node scripts/verify-openapi.mjs && node scripts/generate-api-types.mjs --check",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node tests/integration/demo-api.test.mjs",
    "test:e2e": "node scripts/prepare-test-db.mjs && playwright test",
    "test": "npm run test:unit && npm run verify:openapi && npm run verify:schema && npm run typecheck && npm run build && npm run test:integration && npm run test:e2e",
    "generate:api": "node scripts/generate-api-types.mjs",
    "verify:schema": "node --import tsx scripts/verify-schema.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "concurrently": "^9.2.0"
  },
  "overrides": {
    "fastify": "5.10.0",
    "drizzle-orm": "0.45.2"
  }
}
