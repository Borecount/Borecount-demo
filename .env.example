DATABASE_URL=postgresql://luxledger:luxledger@127.0.0.1:5432/luxledger
DATABASE_URL_TEST=postgresql://luxledger:luxledger@127.0.0.1:5433/luxledger_demo_test
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=20
DB_CONNECT_TIMEOUT=10
NODE_ENV=development
PORT=3000
SHUTDOWN_TIMEOUT_MS=10000
# Optional one-shot admin bootstrap CLI; not required by sandbox creation or API startup.
# Replace this key before invoking bootstrap in any shared deployment.
BOOTSTRAP_TENANT_NAME=Demo tenant
BOOTSTRAP_ADMIN_KEY_NAME=Initial admin key
# Generate with node --input-type=module -e "import { generateApiKey } from '@borecount/core/application'; console.log(generateApiKey())"
BOOTSTRAP_ADMIN_API_KEY=REPLACE_WITH_GENERATED_LLK_KEY
# 32+ random bytes encoded as unpadded base64url. Example generation:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
JWT_SIGNING_KEY=REPLACE_WITH_BASE64URL_32_BYTE_SECRET
JWT_PREVIOUS_SIGNING_KEYS=
JWT_ISSUER=luxledger-api
JWT_ACCESS_TTL_SECONDS=900
JWT_CLOCK_SKEW_SECONDS=5
RATE_LIMIT_AUTH_TOKEN_MAX_REQUESTS=20
RATE_LIMIT_AUTH_TOKEN_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_MAX_REQUESTS=120
RATE_LIMIT_WRITE_WINDOW_SECONDS=60

# Public page metadata, embedded during the Vite build.
VITE_PUBLIC_URL=https://borecount.dev/

# Single-process host resource protection. See docs/OPERATIONS.md.
RATE_LIMIT_READ_MAX_REQUESTS=600
RATE_LIMIT_READ_WINDOW_SECONDS=60
RATE_LIMIT_ABUSE_MAX_REQUESTS=1200
RATE_LIMIT_ABUSE_WINDOW_SECONDS=60
RATE_LIMIT_SESSION_MAX_REQUESTS=20
RATE_LIMIT_SESSION_WINDOW_SECONDS=3600
RATE_LIMIT_MAX_KEYS=10000
REQUEST_BODY_MAX_BYTES=1048576
REQUEST_BULK_MAX_ITEMS=100
REPORT_CONCURRENCY_MAX=4
REPORT_TENANT_CONCURRENCY_MAX=2
# Empty: ignore forwarded client IP/protocol. Use only explicit ingress IPs/CIDRs.
TRUSTED_PROXY_CIDRS=
